---
import { banners } from '../data/banners';
const items = banners.filter(banner => banner.active);
---
<section class="showcase" aria-roledescription="carrossel" aria-label="Destaques da Habitare" data-carousel>
  <h1 class="sr-only">Cuidando de quem cuida na parentalidade — Rede Habitare</h1>
  <div class="slides">
    {items.map((banner, index) => <div class:list={['slide', `theme-${banner.theme}`]} data-slide hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} de ${items.length}`}>
      <picture class="slide-image"><source media="(max-width: 680px)" srcset={banner.mobile} /><img src={banner.desktop} alt="" width="1920" height="640" style={`object-position:${banner.position}`} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} /></picture>
      <div class="container slide-inner"><div class="slide-copy"><p class="eyebrow">{banner.eyebrow}</p><h2>{banner.title}</h2><p class="slide-description">{banner.text}</p><div class="actions"><a class="button" href={banner.href}>{banner.cta}<span aria-hidden="true">↗</span></a>{banner.secondaryCta && <a class="text-link" href={banner.secondaryHref}>{banner.secondaryCta}</a>}</div></div></div>
    </div>)}
  </div>
  {items.length > 1 && <div class="carousel-controls"><div class="carousel-dots" aria-label="Escolher destaque">{items.map((banner,index) => <button data-go={index} aria-label={`Mostrar destaque: ${banner.eyebrow}`} aria-current={index === 0 ? 'true' : 'false'}><span></span></button>)}</div><div class="carousel-navigation"><button data-previous aria-label="Destaque anterior">←</button><button data-next aria-label="Próximo destaque">→</button></div><p class="sr-only" data-announcement aria-live="polite" aria-atomic="true"></p></div>}
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const announce = root.querySelector<HTMLElement>('[data-announcement]');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = reducedMotion.matches;
    let hovered = root.matches(':hover');
    let focused = root.contains(document.activeElement);
    let timer: ReturnType<typeof setTimeout> | undefined;
    let active = 0;
    let animations: Animation[] = [];
    let transition = 0;
    const schedule = () => {
      clearTimeout(timer);
      if (slides.length > 1 && !paused && !hovered && !focused && !document.hidden) {
        timer = setTimeout(() => show(active + 1, false), 5000);
      }
    };
    const show = (index: number, manual = true) => {
      const previous = active;
      active = (index + slides.length) % slides.length;
      const revision = ++transition;
      animations.forEach(animation => animation.cancel());
      animations = [];
      slides.forEach((slide,i) => {
        slide.hidden = i !== active;
        slide.inert = i !== active;
        slide.style.zIndex = i === active ? '1' : '0';
      });
      if (previous !== active && !reducedMotion.matches) {
        const outgoing = slides[previous];
        outgoing.hidden = false;
        const options = { duration: 700, easing: 'cubic-bezier(.22,.61,.36,1)' };
        const fadeOut = outgoing.animate([{ opacity: 1 }, { opacity: 0 }], options);
        const fadeIn = slides[active].animate([{ opacity: 0 }, { opacity: 1 }], options);
        animations.push(fadeOut, fadeIn);
        const copy = slides[active].querySelector<HTMLElement>('.slide-copy');
        if (copy) animations.push(copy.animate([{ transform: 'translateY(14px)' }, { transform: 'translateY(0)' }], options));
        fadeOut.finished.then(() => {
          if (revision === transition) outgoing.hidden = true;
        }).catch(() => {});
      }
      dots.forEach((dot,i) => dot.setAttribute('aria-current', String(i === active)));
      if (announce && manual) announce.textContent = `Destaque ${active + 1} de ${slides.length}: ${slides[active].querySelector('h2')?.textContent}`;
      schedule();
    };
    root.addEventListener('mouseenter', () => { hovered = true; schedule(); });
    root.addEventListener('mouseleave', () => { hovered = false; schedule(); });
    root.addEventListener('focusin', () => { focused = true; schedule(); });
    root.addEventListener('focusout', event => { focused = root.contains(event.relatedTarget as Node | null); schedule(); });
    document.addEventListener('visibilitychange', schedule);
    reducedMotion.addEventListener('change', () => { paused = reducedMotion.matches; show(active, false); });
    schedule();
    dots.forEach((dot,i) => dot.addEventListener('click', () => show(i)));
    root.querySelector('[data-previous]')?.addEventListener('click', () => show(active - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
  }
</script>

<style>
  .slides{display:grid;isolation:isolate;overflow:hidden}
  .slides > .slide{grid-area:1 / 1;min-width:0}
</style>
