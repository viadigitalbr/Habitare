---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; exactTitle?: boolean; socialImage?: string; socialImageAlt?: string; }
const {title, description, exactTitle = false, socialImage, socialImageAlt = ''} = Astro.props;
const pageTitle = exactTitle ? title : `${title} | Rede Habitare`;
const imageUrl = socialImage ? new URL(socialImage, 'https://redehabitare.org.br').href : undefined;
const organization = {'@context':'https://schema.org', '@type':'Organization', '@id':'https://redehabitare.org.br/#organization', name:'Rede Habitare', url:'https://redehabitare.org.br', logo:'https://redehabitare.org.br/images/logo.png'};
const canonical = new URL(Astro.url.pathname, 'https://redehabitare.org.br');
const ready = import.meta.env.PUBLIC_RELEASE_READY === 'true';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description} />
    {!ready && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} /><link rel="icon" href="/images/favicon.png" />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:locale" content="pt_BR" /><meta property="og:site_name" content="Rede Habitare" />
    {imageUrl && <><meta property="og:image" content={imageUrl} /><meta property="og:image:alt" content={socialImageAlt} /><meta property="og:image:type" content="image/webp" /></>}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} />
    {imageUrl && <><meta name="twitter:image" content={imageUrl} /><meta name="twitter:image:alt" content={socialImageAlt} /></>}
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <meta name="theme-color" content="#f8f7f2" />
    <link rel="preload" href="/fonts/lora-variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/raleway-variable.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><Header /><main id="conteudo"><slot /></main><Footer /></body>
</html>
