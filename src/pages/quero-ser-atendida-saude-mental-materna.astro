---
import Base from '../layouts/Base.astro';
import CareHero from '../components/CareHero.astro';
import {forms} from '../data/site';
const modalities = [{title:'Grupo Mães-Bebês',icon:'icone-grupomaes.png',text:'Grupo gratuito de acolhimento e escuta para mães e bebês de até 3 anos de idade.',href:forms.gratuito},{title:'Consultas Terapêuticas',icon:'icone-consultasterapeuticas.png',text:'Atendimento psicológico gratuito na gestação e pós-parto.',href:forms.gratuito},{title:'Clínica Social',icon:'icone-clinicasocial.png',text:'Atendimento psicológico de longo prazo com valor acessível para mães, pais, avós, avôs e demais cuidadores.',href:forms.clinica}];
---
<Base title="Atendimento e acolhimento" description="Conheça os atendimentos online da Habitare: grupo mães-bebês, consultas terapêuticas gratuitas e clínica social.">
  <CareHero page />
  <section class="section care-options" id="atendimentos"><div class="container"><div class="centered care-options-heading"><p class="eyebrow">Um espaço para ser escutada</p><h2>Como podemos acolher você?</h2><p>Conheça as modalidades e acesse o formulário de inscrição para que possamos entrar em contato.</p></div><div class="modalities">{modalities.map((modality) => <article class="modality"><img class="modality-icon" src={`/images/${modality.icon}`} alt="" width="64" height="64" loading="lazy" /><h3>{modality.title}</h3><p>{modality.text}</p><span class="modality-online">Modalidade online</span><a class="button" href={modality.href} target="_blank" rel="noopener" aria-label={`Inscrever-se: ${modality.title} (abre em nova aba)`}>Inscreva-se <span aria-hidden="true">↗</span></a></article>)}</div></div></section>

</Base>
