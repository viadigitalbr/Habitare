# Enable indexing only after Viviana approves the production release.
PUBLIC_RELEASE_READY=false

# Formulário institucional de candidatura.
PUBLIC_MEMBER_FORM_URL=https://forms.gle/dc11j1LE5uw2WjR49

# Livro: habilitar somente após configurar e validar o envio.
# GA4 usa G-R427M1B8Q3, somente com PUBLIC_RELEASE_READY=true E consentimento.
BOOK_ORDERS_ENABLED=false
RESEND_API_KEY=
BOOK_ORDER_FROM_EMAIL=
# Gerar um segredo aleatório de pelo menos 32 caracteres (somente servidor).
BOOK_ORDER_SECRET=
# Origens extras exatas, separadas por vírgula; local: http://127.0.0.1:4321
BOOK_ALLOWED_ORIGINS=
# Rate limiting distribuído; somente hashes de IP, expiração em 660 segundos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
